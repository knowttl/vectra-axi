{
  "name": "@knowttl/vectra-axi",
  "version": "0.1.2",
  "description": "Read-only-first Vectra AXI CLI",
  "bin": {
    "vectra-axi": "bin/vectra-axi.js",
    "vectra-axi-hook": "bin/vectra-axi-hook.js"
  },
  "files": [
    "bin",
    "dist/src",
    "inventory/capabilities.json",
    "skills/vectra-axi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/vectra-axi.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.13",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
