{
  "name": "@knowttl/vectra-axi",
  "version": "0.0.0",
  "description": "Read-only-first Vectra AXI CLI",
  "bin": { "vectra-axi": "bin/vectra-axi.js" },
  "files": ["bin", "dist/src", "inventory/capabilities.json", "skills/vectra-axi"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/vectra-axi.git"
  },
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check"
  },
  "dependencies": {
    "axi-sdk-js": "0.1.13",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@toon-format/toon": "2.3.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
