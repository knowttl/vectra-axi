{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knowttl/vectra-axi/axi-credential.schema.json",
  "title": "Vectra AXI credential profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "origin", "apiVersion", "auth"],
  "properties": {
    "kind": { "enum": ["qux", "rux"] },
    "origin": { "type": "string", "format": "uri", "pattern": "^https://[^/?#@]+$" },
    "apiVersion": { "enum": ["2.5", "3.4"] },
    "auth": { "enum": ["token", "oauth"] },
    "clientId": { "type": "string", "minLength": 1, "pattern": "^[^\\s:]+$" },
    "token": { "$ref": "#/$defs/secretRef", "x-secret": true },
    "clientSecret": { "$ref": "#/$defs/secretRef", "x-secret": true },
    "tokenEnv": { "$ref": "#/$defs/envName", "deprecated": true },
    "secretEnv": { "$ref": "#/$defs/envName", "deprecated": true },
    "applianceRelease": { "type": "string", "pattern": "\\S" },
    "caBundle": { "type": "string", "pattern": "\\S" },
    "writes": {
      "type": "object", "additionalProperties": false,
      "required": ["allowWrites", "operations"],
      "properties": {
        "allowWrites": { "type": "boolean" },
        "operations": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } }
      }
    }
  },
  "oneOf": [
    {
      "properties": { "kind": { "const": "qux" }, "apiVersion": { "const": "2.5" }, "auth": { "const": "token" } },
      "not": { "anyOf": [{ "required": ["clientId"] }, { "required": ["clientSecret"] }, { "required": ["secretEnv"] }, { "required": ["token", "tokenEnv"] }] }
    },
    {
      "required": ["clientId"],
      "properties": { "kind": { "const": "qux" }, "apiVersion": { "const": "2.5" }, "auth": { "const": "oauth" } },
      "not": { "anyOf": [{ "required": ["token"] }, { "required": ["tokenEnv"] }, { "required": ["clientSecret", "secretEnv"] }] }
    },
    {
      "required": ["clientId"],
      "properties": { "kind": { "const": "rux" }, "apiVersion": { "const": "3.4" }, "auth": { "const": "oauth" } },
      "not": { "anyOf": [{ "required": ["token"] }, { "required": ["tokenEnv"] }, { "required": ["applianceRelease"] }, { "required": ["clientSecret", "secretEnv"] }] }
    }
  ],
  "$defs": {
    "envName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "secretRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "$ref": "#/$defs/envName" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } } },
        { "type": "object", "additionalProperties": false, "required": ["stored"], "properties": { "stored": { "const": true } } }
      ]
    }
  }
}
