    "expected": { "issues": [{"path":"$[*][\"field\"]","received":"number","expected":"string"}], "status": 200, "contentType": null, "shape": [{ "path": "$", "type": "array", "count": 2 }, { "path": "$[*]", "type": "object" }, { "path": "$[*][\"field\"]", "type": "number", "expected": "string" }], "shapeTruncated": false, "issuePaths": ["$[*][\"field\"]"], "issuePathsTruncated": false }
  },
  {
