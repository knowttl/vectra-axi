    "expected": { "issues": [{"path":"$[\"<key>\"]","received":"string","expected":"unknown"}], "status": 200, "contentType": null, "shape": [{ "path": "$", "type": "object" }, { "path": "$[\"<key>\"]", "type": "string" }], "shapeTruncated": false, "issuePaths": ["$[\"<key>\"]"], "issuePathsTruncated": false }
  },
  {
